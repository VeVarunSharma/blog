---
import IndexRow from '../../components/content/IndexRow.astro';
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<BaseLayout
  title="Posts"
  description="Field notes from Ve Sharma on AI developer platforms, cloud economics, and software delivery."
>
  <div class="wide-shell">
    <PageIntro
      eyebrow="Field notes from the work"
      title="Posts"
      description="Concise lessons on architecture, developer tooling, cloud tradeoffs, and the work of moving software from intent to adoption."
    />
    {
      posts.length > 0 ? (
        <div class="index-list">
          {posts.map((entry) => (
            <IndexRow entry={entry} />
          ))}
        </div>
      ) : (
        <p class="empty-state">The first post is being written.</p>
      )
    }
  </div>
</BaseLayout>
