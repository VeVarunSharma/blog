---
import IndexRow from '../../components/content/IndexRow.astro';
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPapers } from '../../lib/content';

const papers = await getPapers();
---

<BaseLayout
  title="White papers"
  description="Long-form papers by Ve Sharma on architecture, AI and cloud platforms, and engineering delivery."
>
  <div class="wide-shell">
    <PageIntro
      eyebrow="Evidence, tradeoffs, and systems"
      title="White papers"
      description="Deeper arguments about the technical, economic, and organizational choices behind software systems. Each paper is designed to stand on its own."
    />
    {
      papers.length > 0 ? (
        <div class="index-list">
          {papers.map((entry) => (
            <IndexRow entry={entry} />
          ))}
        </div>
      ) : (
        <p class="empty-state">The first white paper is being prepared.</p>
      )
    }
  </div>
</BaseLayout>
