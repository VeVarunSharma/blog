---
import { render } from 'astro:content';
import Callout from '../../components/content/Callout.astro';
import Figure from '../../components/content/Figure.astro';
import FlowDiagram from '../../components/diagrams/FlowDiagram.astro';
import PaperLayout from '../../layouts/PaperLayout.astro';
import {
  getAllPublications,
  getPapers,
  getRelatedPublications,
  type AnyPublication,
  type PaperEntry,
} from '../../lib/content';

interface Props {
  entry: PaperEntry;
  related: AnyPublication[];
}

export async function getStaticPaths() {
  const [papers, allEntries] = await Promise.all([
    getPapers(),
    getAllPublications(),
  ]);

  return papers.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      related: getRelatedPublications(entry, allEntries),
    },
  }));
}

const { entry, related } = Astro.props;
const { Content, headings } = await render(entry);
const components = { Callout, Figure, FlowDiagram };
---

<PaperLayout entry={entry} headings={headings} related={related}>
  <Content components={components} />
</PaperLayout>
