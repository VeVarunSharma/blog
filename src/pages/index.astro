---
import PublicationCard from '../components/content/PublicationCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPapers, getPosts, publicationPath } from '../lib/content';
import { formatPaperNumber } from '../lib/publications';

const [posts, papers] = await Promise.all([getPosts(), getPapers()]);
const featuredPaper = papers.find(({ data }) => data.featured) ?? papers[0];
const latestPosts = posts.slice(0, 3);
const latestPapers = papers.slice(0, 2);
---

<BaseLayout>
  <div class="wide-shell">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow">
          AI platforms · Cloud economics · Software delivery
        </p>
        <h1 id="home-title">
          Turning strategy into <span>software that ships.</span>
        </h1>
        <p class="hero-lede">
          I write about AI developer platforms, cloud economics, and the
          architecture, tooling, and operating decisions behind software
          delivery.
        </p>
      </div>

      <aside class="hero-panel" aria-label="Featured white paper">
        {
          featuredPaper ? (
            <>
              <div>
                <span class="hero-panel-label">Current white paper</span>
                <p class="hero-paper-number">
                  No. {formatPaperNumber(featuredPaper.data.paperNumber)}
                </p>
                <h2>{featuredPaper.data.title}</h2>
                <p>{featuredPaper.data.description}</p>
              </div>
              <a class="text-link" href={publicationPath(featuredPaper)}>
                Read the paper
              </a>
            </>
          ) : (
            <>
              <div>
                <span class="hero-panel-label">White papers</span>
                <h2>Long-form work is taking shape.</h2>
                <p>
                  White papers make the evidence and tradeoffs behind the
                  shorter field notes explicit.
                </p>
              </div>
              <a class="text-link" href="/papers/">
                Browse papers
              </a>
            </>
          )
        }
      </aside>
    </section>

    <section class="publication-section" aria-labelledby="latest-posts">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Platforms, practice, and field notes</p>
          <h2 id="latest-posts">Latest posts</h2>
        </div>
        <a href="/posts/">View all posts</a>
      </div>
      {
        latestPosts.length > 0 ? (
          <div class="card-grid">
            {latestPosts.map((entry) => (
              <PublicationCard entry={entry} />
            ))}
          </div>
        ) : (
          <p class="empty-state">The first post is being written.</p>
        )
      }
    </section>

    <section class="publication-section" aria-labelledby="white-papers">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Architecture, economics, and delivery</p>
          <h2 id="white-papers">White papers</h2>
        </div>
        <a href="/papers/">Open the library</a>
      </div>
      {
        latestPapers.length > 0 ? (
          <div class="card-grid two-up">
            {latestPapers.map((entry) => (
              <PublicationCard entry={entry} />
            ))}
          </div>
        ) : (
          <p class="empty-state">The first white paper is being prepared.</p>
        )
      }
    </section>
  </div>
</BaseLayout>
