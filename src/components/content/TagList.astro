---
import { displayTag, normalizeTag } from '../../lib/publications';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="tag-list" aria-label="Tags">
  {
    tags.map((tag) => (
      <a class="tag-link" href={`/tags/${normalizeTag(tag)}/`}>
        {displayTag(normalizeTag(tag))}
      </a>
    ))
  }
</div>
