---
import type { AnyPublication, PostEntry } from '../lib/content';
import { publicationPath } from '../lib/content';
import { formatDate, getReadingMinutes } from '../lib/publications';
import { SITE } from '../config';
import CodeEnhancer from '../components/content/CodeEnhancer.astro';
import RelatedContent from '../components/content/RelatedContent.astro';
import TagList from '../components/content/TagList.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: PostEntry;
  related: AnyPublication[];
}

const { entry, related } = Astro.props;
const canonical =
  entry.data.canonicalUrl ??
  new URL(publicationPath(entry), Astro.site).toString();
const image = entry.data.image?.src ?? '/social-card.png';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: (entry.data.updatedAt ?? entry.data.publishedAt).toISOString(),
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.url,
  },
  publisher: {
    '@type': 'Person',
    name: SITE.author,
  },
  mainEntityOfPage: canonical,
  url: canonical,
  image: new URL(image, Astro.site).toString(),
  keywords: entry.data.tags.join(', '),
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalUrl={canonical}
  image={image}
  type="article"
  jsonLd={jsonLd}
>
  <article class="reader-shell">
    <header class="reader-header">
      <p class="reader-kind">Post / {formatDate(entry.data.publishedAt)}</p>
      <h1 class="reader-title">{entry.data.title}</h1>
      <p class="reader-description">{entry.data.description}</p>

      <div class="reader-metadata">
        <div class="metadata-item">
          <span class="metadata-label">Written by</span>
          <span class="metadata-value">{SITE.author}</span>
        </div>
        <div class="metadata-item">
          <span class="metadata-label">Published</span>
          <time
            class="metadata-value"
            datetime={entry.data.publishedAt.toISOString()}
          >
            {formatDate(entry.data.publishedAt)}
          </time>
        </div>
        {
          entry.data.updatedAt && (
            <div class="metadata-item">
              <span class="metadata-label">Updated</span>
              <time
                class="metadata-value"
                datetime={entry.data.updatedAt.toISOString()}
              >
                {formatDate(entry.data.updatedAt)}
              </time>
            </div>
          )
        }
        <div class="metadata-item">
          <span class="metadata-label">Reading time</span>
          <span class="metadata-value">{getReadingMinutes(entry.body)} min</span
          >
        </div>
      </div>
      <div class="reader-tags">
        <TagList tags={entry.data.tags} />
      </div>
    </header>

    <div class="reader-grid post-reader-grid">
      <div class="prose">
        <slot />

        {
          entry.data.repositoryUrl && (
            <div class="source-link">
              <span>Source material</span>
              <a href={entry.data.repositoryUrl}>View repository</a>
            </div>
          )
        }

        <RelatedContent entries={related} />
      </div>
    </div>
  </article>
  <CodeEnhancer />
</BaseLayout>
